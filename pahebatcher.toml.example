# pahebatcher configuration — copy to pahebatcher.toml and edit
# This file is the committed example; pahebatcher.toml itself is git-ignored.
# Note: resolve_ahead = 1 here is the recommended serial setting;
# the code default is 999 (unlimited prefetch).

quality = 1080
audio_lang = 'jpn'
max_parallel = 2
hls_workers = 24
output_dir = './downloads'
keep_temp = false
resolve_ahead = 1
cache_ttl = 60
cookie_string = ''
auto_retry = 2
clearance_ttl = 20
